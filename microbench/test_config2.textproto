# Sample configuration for microbench.runner2.
# This demonstrates a simple READ operation benchmark with branch setup.

run_id: "test_read_benchmark"
backend: DOLT
table_name: "customer"
scale_factor: 1

# Database setup: load the bundled CH-benCHmark sample.
database_setup {
  db_name: "tpcc_test"
  cleanup: true
  sql_dump {
    sql_dump_path: "db_setup/ch_benchmark_seed.sql"
  }
}

# Benchmark settings
num_threads: 1
measure_storage: false

# Single operation benchmark
operation_benchmark {
  operation: READ
  num_ops: 100

  # Setup phase: create branches with data
  setup {
    num_branches: 10
    branch_shape: FAN_OUT
    inserts_per_branch: 50
    updates_per_branch: 20
    deletes_per_branch: 10
  }
}
