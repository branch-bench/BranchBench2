# Sample configuration for microbench.runner2.run()
# This demonstrates a simple READ operation benchmark with branch setup.
# The embedding application provisions the database and passes a
# dblib.target.PreparedTarget; the table below must exist in it.

run_id: "test_read_benchmark"
table_name: "customer"
scale_factor: 1

# Benchmark settings
num_threads: 1
measure_storage: false

# Single operation benchmark
operation_benchmark {
  operation: READ
  num_ops: 100

  # Setup phase: create branches with data
  setup {
    num_branches: 10
    branch_shape: FAN_OUT
    inserts_per_branch: 50
    updates_per_branch: 20
    deletes_per_branch: 10
  }
}
