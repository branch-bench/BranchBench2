#!/bin/bash
# Start Dolt's MySQL-protocol server the way dblib/systems/dolt_mysql/adapter.py expects it:
# 127.0.0.1:3306, user root with no password, data in ~/dolt/databases.
set -euo pipefail

runs="${DBFORK_STATE_DIR:?DBFORK_STATE_DIR is required}"
data_dir="${DOLT_MYSQL_DATA_DIR:-$HOME/dolt/databases}"
host="${DOLT_MYSQL_HOST:-${DBFORK_SERVER_HOST:-127.0.0.1}}"
port="${DOLT_MYSQL_PORT:-3306}"
mkdir -p "$runs" "$data_dir"

if [ -f "$runs/dolt_mysql.pid" ] && kill -0 "$(cat "$runs/dolt_mysql.pid")" 2>/dev/null; then
    echo "Dolt already running (pid $(cat "$runs/dolt_mysql.pid"))"
    exit 0
fi

if command -v dolt >/dev/null 2>&1; then
    dolt_bin="$(command -v dolt)"
elif [ -x "$HOME/dolt/bin/dolt" ]; then
    dolt_bin="$HOME/dolt/bin/dolt"
else
    echo "dolt binary not found" >&2
    exit 1
fi

if [ ! -f "$HOME/.dolt/config_global.json" ]; then
    "$dolt_bin" config --global --add user.email "benchmark@localhost" >/dev/null 2>&1 || true
    "$dolt_bin" config --global --add user.name "benchmark" >/dev/null 2>&1 || true
fi

cd "$data_dir"
"$dolt_bin" sql-server --data-dir "$data_dir" \
    --host "$host" --port "$port" \
    > "$runs/dolt_mysql.log" 2>&1 &
echo $! > "$runs/dolt_mysql.pid"
