#!/bin/bash
# Ensure PostgreSQL 18 and the Chronos Python library (chronos-core) are installed.
set -euo pipefail

bash "$(dirname "$0")/../file_copy/install"

repo_root="$(cd "$(dirname "$0")/../../.." && pwd)"
py="${PYTHON:-python3}"

check_chronos() {
    if command -v uv >/dev/null 2>&1 && [ -f "$repo_root/pyproject.toml" ]; then
        (cd "$repo_root" && uv run --frozen python -c "from chronos_core.branching import ChronosBranchContext") >/dev/null 2>&1 && return 0
    fi
    "$py" -c "from chronos_core.branching import ChronosBranchContext" >/dev/null 2>&1
}

if check_chronos; then
    exit 0
fi

if [ "$(uname -s)" = "Linux" ] && command -v apt-get >/dev/null 2>&1; then
    sudo -n apt-get update -qq >/dev/null 2>&1 || true
    sudo -n DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        libpq-dev libboost-dev libsqlite3-dev python3-dev g++ cmake pkg-config git >/dev/null
fi

if [ -n "${CHRONOS_PIP_SPEC:-}" ]; then
    if command -v uv >/dev/null 2>&1; then
        uv pip install --python "$py" "$CHRONOS_PIP_SPEC" >/dev/null
    else
        "$py" -m pip install "$CHRONOS_PIP_SPEC" >/dev/null
    fi
elif command -v uv >/dev/null 2>&1 && [ -f "$repo_root/pyproject.toml" ]; then
    (cd "$repo_root" && uv sync --frozen --extra chronos >/dev/null)
else
    "$py" -m pip install "chronos-core @ git+https://github.com/mitdbg/chronos@607418d4d06ba1a67be0e9e5a7617132f265a87c#subdirectory=packages/chronos-core" >/dev/null
fi

if check_chronos; then
    exit 0
fi

echo "chronos-core Python package could not be imported after installation; verify C++ build dependencies (libpq, boost, sqlite3, cmake) and run 'uv sync --frozen --extra chronos'" >&2
exit 1
