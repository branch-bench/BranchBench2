#!/bin/bash
# Stop the Doltgres process that start launched, and nothing else.
set -euo pipefail

runs="${DBFORK_STATE_DIR:?DBFORK_STATE_DIR is required}"
[ -f "$runs/dolt.pid" ] || exit 0
pid="$(cat "$runs/dolt.pid")"

if kill -0 "$pid" 2>/dev/null; then
    if [ "$(basename "$(ps -o comm= -p "$pid")")" != "doltgres" ]; then
        echo "pid $pid is not doltgres; leaving it alone" >&2
        exit 1
    fi
    kill "$pid"
    for _ in $(seq 1 20); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "doltgres (pid $pid) is still running after 10 s; keeping its pid file" >&2
        exit 1
    fi
fi
rm -f "$runs/dolt.pid"
