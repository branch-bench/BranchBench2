#!/bin/bash
# Ensure Doltgres is installed in one of the locations dolt/start checks.
set -euo pipefail

if command -v doltgres >/dev/null 2>&1 || [ -x "$HOME/doltgres-1.4.0/dl/doltgresql-linux-amd64/bin/doltgres" ]; then
    exit 0
fi

if [ "$(uname -s)" = "Linux" ]; then
    arch="$(uname -m)"
    case "$arch" in
        x86_64|amd64) platform="linux-amd64" ;;
        aarch64|arm64) platform="linux-arm64" ;;
        *) echo "Unsupported Linux architecture for doltgres: $arch" >&2; exit 1 ;;
    esac
    # DOLT_* is the prefix the dolt connector forwards to this script.
    ver="${DOLT_VERSION:-v1.4.0}"
    dest="$HOME/doltgres-1.4.0/dl"
    mkdir -p "$dest" "$HOME/.local/bin"
    url="https://github.com/dolthub/doltgresql/releases/download/${ver}/doltgresql-${platform}.tar.gz"
    curl -fsSL "$url" | tar -xz -C "$dest"
    if [ -x "$dest/doltgresql-${platform}/bin/doltgres" ]; then
        if [ "$platform" != "linux-amd64" ]; then
            mkdir -p "$dest/doltgresql-linux-amd64/bin"
            ln -sfn "$dest/doltgresql-${platform}/bin/doltgres" "$dest/doltgresql-linux-amd64/bin/doltgres"
        fi
        ln -sfn "$dest/doltgresql-${platform}/bin/doltgres" "$HOME/.local/bin/doltgres"
        exit 0
    fi
fi

echo "doltgres binary not found; install doltgres or set PATH" >&2
exit 1
