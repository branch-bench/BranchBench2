#!/bin/bash
# Install the Dolt binary used as inkeun-demo-db's mock implementation.
set -euo pipefail

if command -v dolt >/dev/null 2>&1 || [ -x "$HOME/dolt/bin/dolt" ]; then
    exit 0
fi

if [ "$(uname -s)" = "Linux" ]; then
    arch="$(uname -m)"
    case "$arch" in
        x86_64|amd64) platform="linux-amd64" ;;
        aarch64|arm64) platform="linux-arm64" ;;
        *) echo "Unsupported Linux architecture: $arch" >&2; exit 1 ;;
    esac
    ver="${DOLT_MYSQL_VERSION:-v2.4.2}"
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    url="https://github.com/dolthub/dolt/releases/download/${ver}/dolt-${platform}.tar.gz"
    curl -fsSL "$url" | tar -xz -C "$tmp"
    if [ -x "$tmp/dolt-${platform}/bin/dolt" ]; then
        mkdir -p "$HOME/dolt/bin" "$HOME/.local/bin"
        cp -f "$tmp/dolt-${platform}/bin/dolt" "$HOME/dolt/bin/dolt"
        chmod +x "$HOME/dolt/bin/dolt"
        ln -sfn "$HOME/dolt/bin/dolt" "$HOME/.local/bin/dolt"
        exit 0
    fi
fi

echo "inkeun-demo-db mock backend binary not found" >&2
exit 1
