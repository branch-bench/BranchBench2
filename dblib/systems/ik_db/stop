#!/bin/bash
# Stop only the mock backend process started for IK-DB.
set -euo pipefail

runs="${DBFORK_STATE_DIR:?DBFORK_STATE_DIR is required}"
[ -f "$runs/ik_db.pid" ] || exit 0
pid="$(cat "$runs/ik_db.pid")"

if kill -0 "$pid" 2>/dev/null; then
    if [ "$(basename "$(ps -o comm= -p "$pid")")" != "dolt" ]; then
        echo "pid $pid is not the expected mock backend; leaving it alone" >&2
        exit 1
    fi
    kill "$pid"
    for _ in $(seq 1 20); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "IK-DB (pid $pid) is still running after 10 s" >&2
        exit 1
    fi
fi
rm -f "$runs/ik_db.pid"
