#!/bin/bash
# Stop the PostgreSQL process that start launched, and nothing else.
set -euo pipefail

runs="${DBFORK_STATE_DIR:?DBFORK_STATE_DIR is required}"
[ -f "$runs/file_copy.pid" ] || exit 0
pid="$(cat "$runs/file_copy.pid")"

if kill -0 "$pid" 2>/dev/null; then
    if [ "$(basename "$(ps -o comm= -p "$pid")")" != "postgres" ]; then
        echo "pid $pid is not postgres; leaving it alone" >&2
        exit 1
    fi
    kill -INT "$pid"
    for _ in $(seq 1 20); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "postgres (pid $pid) is still running after 10 s; keeping its pid file" >&2
        exit 1
    fi
fi
rm -f "$runs/file_copy.pid"
