#!/bin/bash
# Start SeekDB (OceanBase) the way dblib/systems/seekdb/adapter.py expects it:
# 127.0.0.1:2881, user root with no password.
set -euo pipefail

runs="${DBFORK_STATE_DIR:?DBFORK_STATE_DIR is required}"
if [ -n "${SEEKDB_DATA_DIR:-}" ]; then
    data_dir="$SEEKDB_DATA_DIR"
elif [ -d "$HOME/seekdb/store" ]; then
    data_dir="$HOME/seekdb/store"
elif [ -d "/opt/homebrew/var/seekdb/data" ] || [ -d "/opt/homebrew/var/seekdb" ]; then
    data_dir="/opt/homebrew/var/seekdb/data"
else
    data_dir="$HOME/seekdb/store"
fi
seekdb_home="$(dirname "$data_dir")"
mkdir -p "$runs" "$data_dir" "$seekdb_home/log" "$seekdb_home/run" "$seekdb_home/etc"

if [ -f "$runs/seekdb.pid" ] && kill -0 "$(cat "$runs/seekdb.pid")" 2>/dev/null; then
    echo "SeekDB already running (pid $(cat "$runs/seekdb.pid"))"
    exit 0
fi

if [ -n "${SEEKDB_BIN:-}" ]; then
    seekdb_bin="$SEEKDB_BIN"
elif command -v seekdb >/dev/null 2>&1; then
    seekdb_bin="$(command -v seekdb)"
elif [ -x "/opt/homebrew/opt/seekdb/bin/seekdb" ]; then
    seekdb_bin="/opt/homebrew/opt/seekdb/bin/seekdb"
elif [ -x "$HOME/seekdb/bin/seekdb" ]; then
    seekdb_bin="$HOME/seekdb/bin/seekdb"
else
    seekdb_bin="$HOME/seekdb/build/debug/src/observer/seekdb"
fi

ulimit -n 65536 2>/dev/null || true
ulimit -c 0 2>/dev/null || true
export DYLD_FALLBACK_LIBRARY_PATH="/opt/homebrew/opt/seekdb/libexec/compat:${DYLD_FALLBACK_LIBRARY_PATH:-/usr/local/lib:/lib:/usr/lib}"
export LD_LIBRARY_PATH="$HOME/seekdb/lib:/usr/local/lib:/lib:/usr/lib:${LD_LIBRARY_PATH:-}"
cd "$data_dir"
"$seekdb_bin" --nodaemon --base-dir="$data_dir" > "$runs/seekdb.log" 2>&1 &
echo $! > "$runs/seekdb.pid"
