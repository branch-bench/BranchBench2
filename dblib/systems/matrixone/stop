#!/bin/bash
# Stop the MatrixOne process that start launched, and nothing else.
set -euo pipefail

runs="${DBFORK_STATE_DIR:?DBFORK_STATE_DIR is required}"
[ -f "$runs/matrixone.pid" ] || exit 0
pid="$(cat "$runs/matrixone.pid")"

if kill -0 "$pid" 2>/dev/null; then
    if [ "$(basename "$(ps -o comm= -p "$pid")")" != "mo-service" ]; then
        echo "pid $pid is not mo-service; leaving it alone" >&2
        exit 1
    fi
    kill "$pid"
    for _ in $(seq 1 40); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "mo-service (pid $pid) is still running after 20 s; keeping its pid file" >&2
        exit 1
    fi
fi
rm -f "$runs/matrixone.pid"
