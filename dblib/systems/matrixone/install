#!/bin/bash
# Ensure MatrixOne is installed in one of the locations matrixone/start checks.
set -euo pipefail

mo_root="${MO_HOME:-$HOME/mo/matrixone}"
if { [ -n "${MO_BIN:-}" ] && [ -x "$MO_BIN" ]; } \
    || [ -x "$mo_root/mo-service" ] \
    || [ -x "$HOME/mo/matrixone/mo-service" ] \
    || command -v mo-service >/dev/null 2>&1; then
    if [ -f "$mo_root/etc/launch/launch.toml" ] || [ -f "$HOME/mo/matrixone/etc/launch/launch.toml" ]; then
        exit 0
    fi
fi

if [ -n "${MO_ARCHIVE_URL:-}" ]; then
    mkdir -p "$mo_root"
    curl -fsSL "$MO_ARCHIVE_URL" | tar -xz -C "$mo_root"
    if [ -x "$mo_root/mo-service" ] && [ -f "$mo_root/etc/launch/launch.toml" ]; then
        exit 0
    fi
fi

echo "MatrixOne binary or launch.toml not found in ~/mo/matrixone; use --ami-id with prebaked ~/mo/matrixone or set MO_ARCHIVE_URL" >&2
exit 1
