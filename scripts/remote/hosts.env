# One server per machine (all c8i.4xlarge, Ubuntu 24.04, us-east-1b, same VPC
# as the driver). Private IPs carry the benchmark traffic; the public names
# are only for getting in. Source this file: it defines HOST_<backend>.
SSH_KEY=$HOME/.ssh/db-forking-key.pem
SSH_USER=ubuntu
DRIVER_PRIVATE_IP=172.31.42.201

HOST_dolt=172.31.46.108        # ec2-54-166-242-252.compute-1.amazonaws.com  Doltgres 1.4.0 :5432
HOST_dolt_mysql=172.31.39.199  # ec2-13-221-119-209.compute-1.amazonaws.com  Dolt 2.4.2 :3306
HOST_seekdb=172.31.32.101      # ec2-54-152-81-169.compute-1.amazonaws.com   SeekDB 1.4.0 :2881
HOST_matrixone=172.31.34.47    # ec2-3-89-191-127.compute-1.amazonaws.com    MatrixOne 4.2.5 :6001
HOST_file_copy=172.31.35.190   # ec2-100-54-223-248.compute-1.amazonaws.com  PostgreSQL 18 :5434
HOST_chronos=172.31.41.14      # ec2-18-234-228-242.compute-1.amazonaws.com  PostgreSQL 18 :5434
