# S1 Agentic RL environment, smoke size.
run_id: "macro_rl_env_mini_dolt"
backend: DOLT
database_setup { db_name: "macro_rl_env_mini" cleanup: true generated {} }
schema { base: CH_BENCH scale_factor: 1 items: 1000 customers_per_district: 100 orders_per_district: 100 suppliers: 100 }
workload {
  branch_ops { commit_interval: 1 }
  data_ops { statements_per_step: 4 rows_per_write: 20 write_fraction: 0.5 ddl_fraction: 0.2 worker_threads: 2 }
  rl_env { tasks: 2 group_size: 3 step_budget: 3 rollouts_per_round: 2 historical_fork_prob: 0.5 }
}
