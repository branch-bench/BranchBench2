# Example scenario (macrobench/scenarios/template.py), full size.
run_id: "macro_example_dolt"
backend: DOLT
database_setup { db_name: "macro_example" cleanup: true generated {} }
schema { base: NO_BASE }
workload {
  branch_ops { commit_interval: 1 }
  data_ops { worker_threads: 4 }
  scenario: "example"
  params { key: "features"         value: "16" }
  params { key: "rows_per_feature" value: "100" }
  params { key: "merge_every"      value: "2" }
}
